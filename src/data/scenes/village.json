        { "itemId": "beast_core", "min": 1, "max": 1, "weight": 1 }
      ] }
    ]
  },
  {
    "id": "ferry",
    "name": "青石渡口",
    "description": "江水滔滔，拍打着青石砌成的渡头。几艘乌篷船随波起伏，老艄公蹲在船头吧嗒吧嗒抽着旱烟。江心偶有沉船的桅杆露出水面，据说底下压着不少前朝的物事。往南穿过芦苇荡，便是另一番天地。",
    "connections": ["village", "town", "reed", "tongji_port"],
    "npcs": ["ferryman"],
