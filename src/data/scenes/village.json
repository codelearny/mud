    "id": "village",
    "name": "青石村",
    "description": "青石村坐落山谷之中，屋舍俨然，炊烟袅袅。村口一株老槐遮天蔽日，树下老人们摇扇闲谈。一条青石小径向东通往清风镇，向西没入后山云雾，向南则是滔滔江水与青石渡口。",
    "connections": ["mountain", "town", "ferry"],
    "npcs": ["village_chief", "innkeeper"],
    "actions": [
      { "id": "rest", "label": "客栈歇息", "type": "rest", "text": "你在客栈歇脚，饱餐一顿，气血内力尽复。" },
      { "id": "explore_village", "label": "村中漫步", "type": "encounter", "text": "你在村中漫步，或许能遇上些机缘。", "encounters": ["enc_bottle", "enc_herb", "enc_master"] }
    ]
  },
  {
    "id": "mountain",
    "name": "后山",
    "description": "后山林木幽深，怪石嶙峋。山道旁时见被劫杀的行商尸骸，显然有匪类盘踞。崖边有一处平坦石台，似是前人练功之所；密林深处，隐隐有剑气冲霄，传说埋着前朝剑客的剑冢。",
    "connections": ["village", "forest", "blackwind", "sword_tomb", "ancient_battlefield"],
    "npcs": ["hunter"],
    "enemyPool": ["ruffian", "bandit", "wild_wolf", "boar"],
    "actions": [
      { "id": "explore_mountain", "label": "搜山寻敌", "type": "encounter", "text": "你提气轻身，深入后山搜寻匪踪。", "encounters": ["enc_wild_trap", "enc_wild_cave", "enc_wild_merchant", "enc_robber"] },
      { "id": "train", "label": "石台练功", "type": "train", "text": "你在石台上吐纳运功，隐隐有所领悟。" },
      { "id": "gather_herb", "label": "山间采药", "type": "gather", "text": "你在山石草木间寻觅药材。", "gains": [
