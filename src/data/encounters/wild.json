    "title": "猎户陷阱",
    "text": "林间一处伪装精巧的陷坑，坑底一头野猪正嗷嗷乱叫，腿上还缠着磨损的兽夹。它红着眼盯着你。",
    "choices": [
      { "text": "取其兽丹，与野猪搏命", "next": "END", "battle": "boar" },
      { "text": "悄悄放生，积德行善", "next": "END", "effects": [{ "type": "flag", "target": "freed_beast", "value": true }] },
      { "text": "不予理会", "next": "END" }
    ]
  },
  {
