      { "text": "洞口风紧，退去", "next": "END" }
    ]
  },
  {
    "id": "enc_wild_fog",
    "title": "林中迷雾",
    "text": "不过转眼的工夫，浓雾四合，来路去路皆已难辨，林深处传来低沉的兽吼，一头饿狼循声而来。",
    "choices": [
      { "text": "循声迎战饿狼", "next": "END", "battle": "wild_wolf" },
      { "text": "静心辨向，寻得归途", "next": "END", "effects": [{ "type": "flag", "target": "found_path", "value": true }] },
      { "text": "原路折返", "next": "END" }
    ]
  },
  {
    "id": "enc_wild_merchant",
    "title": "落难行商",
    "text": "树下靠着个衣衫褴褛的行商，腿上血迹斑斑：『好汉……在下被劫了道，能否护送我一程？』话音未落，林中闪出劫道的。",
    "choices": [
      { "text": "答应护送，与劫徒恶战", "next": "END", "battle": "bandit" },
      { "text": "只赠些干粮，结个善缘", "next": "END", "effects": [{ "type": "flag", "target": "aided_merchant", "value": true }] },
      { "text": "爱莫能助，离去", "next": "END" }
