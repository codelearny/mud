      { "text": "退去", "next": "END" }
    ]
  },
  {
    "id": "enc_valley_flower",
    "title": "幽谷奇花",
    "text": "绝壁上一朵碗口大的白花在夜风中轻颤，花瓣上凝着露珠，异香扑鼻。花下却伏着一头野猪，护着这株奇花。",
    "choices": [
      { "text": "攀壁夺花，与野猪相争", "next": "END", "battle": "boar" },
