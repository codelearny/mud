    "id": "enc_valley_spring",
    "title": "药泉",
    "text": "谷心一汪清泉汩汩涌出，水面上浮着淡淡的药气。泉边却盘着一条护泉的灵蛇，嘶嘶吐信。",
    "choices": [
      { "text": "降服护泉灵蛇，夺泉中灵泉", "next": "END", "battle": "venom_snake" },
      { "text": "掬饮泉水，调息疗伤", "next": "END", "effects": [{ "type": "heal", "value": "full" }] },
      { "text": "不敢造次，离去", "next": "END" }
    ]
  },
  {
