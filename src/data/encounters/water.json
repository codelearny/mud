[
  {
    "id": "enc_ferry_talk",
    "title": "艄公闲话",
    "once": true,
    "text": "老艄公磕了磕烟袋：『客官，这江水底下可埋着不少故事。前朝那支运宝的船队，就沉在下游第三道弯里。』话音未落，岸边蹿出个劫道的。",
    "choices": [
      { "text": "护住船家，与劫徒一战", "next": "END", "battle": "waylayer" },
      { "text": "只闲话家常，结个善缘", "next": "END", "effects": [{ "type": "affinity", "target": "mysterious_master", "value": 5 }] },
      { "text": "多谢，告辞", "next": "END" }
    ]
  },
  {
    "id": "enc_boat_wreck",
    "title": "沉船遗骸",
    "text": "退潮时分，一截焦黑的船骸从江底露出，舱板缝隙里卡着东西，泛着金属的光。水下却潜伏着巡江的水寇。",
    "choices": [
      { "text": "下水驱赶水寇，夺那舱中之物", "next": "END", "battle": "river_pirate" },
      { "text": "只记下沉船方位，报官查抄改日", "next": "END", "effects": [{ "type": "flag", "target": "wreck_marker", "value": true }] },
      { "text": "晦气，走开", "next": "END" }
    ]
  },
  {
    "id": "enc_river_trade",
    "title": "江上商船",
    "text": "一艘满载货物的商船缓缓靠岸，船主满面堆笑地迎上来：『这位爷，可要捎带些货物？』舱后却藏着不速之客。",
    "choices": [
      { "text": "强行讨个说法（与水寇交手）", "next": "END", "battle": "river_pirate" },
      { "text": "好言攀谈，换得些船家见闻", "next": "END", "effects": [{ "type": "flag", "target": "river_lore", "value": true }] },
      { "text": "不做理会", "next": "END" }
    ]
  },
  {
